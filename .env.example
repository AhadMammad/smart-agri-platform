# =============================================================================
# smart-agri-platform — environment configuration
#
# Copy to `.env` before starting the stack:   make env
# `.env` is git-ignored; this file is the committed template.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=smart-agri

# -----------------------------------------------------------------------------
# Image tags — pinned deliberately. See docs/architecture.md before changing.
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8-alpine
HADOOP_IMAGE=apache/hadoop:3.4.3
HIVE_IMAGE=apache/hive:4.0.1
AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.12
SUPERSET_IMAGE=apache/superset:4.1.1
REDIS_IMAGE=redis:7.4-alpine
LIQUIBASE_IMAGE=liquibase/liquibase:4.30

# The ETL image is built locally from docker/etl/Dockerfile (`make build-etl`).
ETL_IMAGE=smart-agri-etl:local

# -----------------------------------------------------------------------------
# Source database — PostgreSQL (OLTP, Liquibase-managed)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agri
POSTGRES_USER=agri
POSTGRES_PASSWORD=agri
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Analytics database — ClickHouse
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=agri_analytics
CLICKHOUSE_USER=agri
CLICKHOUSE_PASSWORD=agri
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000

# -----------------------------------------------------------------------------
# Lake — HDFS
#
# The ETL app talks to HDFS over WebHDFS (no JVM in the ETL image), so it needs
# the NameNode HTTP port. The Hive Metastore uses the RPC port.
# -----------------------------------------------------------------------------
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_RPC_PORT=8020
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_DATANODE_HTTP_PORT=9864
HDFS_NAMENODE_HTTP_HOST_PORT=9870
HDFS_DATANODE_HTTP_HOST_PORT=9864
HDFS_USER=root
HDFS_LAKE_ROOT=/lake

# -----------------------------------------------------------------------------
# Hive Metastore — catalog over the Parquet zones; on-ramp to Iceberg later
# -----------------------------------------------------------------------------
HIVE_METASTORE_HOST=hive-metastore
HIVE_METASTORE_PORT=9083
HIVE_METASTORE_HOST_PORT=9083
METASTORE_DB=metastore
METASTORE_DB_USER=hive
METASTORE_DB_PASSWORD=hive

# -----------------------------------------------------------------------------
# Airflow — CeleryExecutor
#
# AIRFLOW_UID must match a host user that can read /var/run/docker.sock, because
# DockerOperator tasks spawn sibling containers on the host daemon.
#   Set it with:  echo "AIRFLOW_UID=$(id -u)" >> .env
# DOCKER_GID must be the host's `docker` group id:  getent group docker | cut -d: -f3
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
DOCKER_GID=999
AIRFLOW_HOST_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
# Generate real values for a non-throwaway deployment:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=insecure-dev-secret-key-change-me

# The Docker network DockerOperator attaches task containers to. Must match the
# network declared in docker-compose.yml, prefixed by COMPOSE_PROJECT_NAME.
ETL_TASK_NETWORK=smart-agri_agri-net

# -----------------------------------------------------------------------------
# Superset
# -----------------------------------------------------------------------------
SUPERSET_HOST_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset
SUPERSET_SECRET_KEY=insecure-dev-secret-key-change-me

# -----------------------------------------------------------------------------
# ETL application
# -----------------------------------------------------------------------------
SMART_AGRI_LOG_LEVEL=INFO
SMART_AGRI_ENV=dev

# -----------------------------------------------------------------------------
# Open-Meteo (Phase 4) — free tier, no API key required
# -----------------------------------------------------------------------------
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MAX_RPS=1.0
OPEN_METEO_MAX_RETRIES=5

# -----------------------------------------------------------------------------
# Data generator (Phase 2/3)
# -----------------------------------------------------------------------------
GENERATOR_PROFILE=small
GENERATOR_SEED=20260731
