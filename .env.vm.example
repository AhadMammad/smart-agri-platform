# Connection details for the x86_64 Ubuntu VM that phases are verified on.
#
# Copy to .env.vm and fill in. .env.vm is gitignored: this repo is public and
# the VM's address is not something to publish.
#
#   cp .env.vm.example .env.vm
#   scripts/vm.sh status

# Hostname or IP of the VM.
VM_HOST=

# Login user on the VM.
VM_USER=

# Private key for that user. Optional — omit to use your SSH agent or
# ~/.ssh/config. A leading ~ is expanded.
VM_SSH_KEY=~/.ssh/id_ed25519

# Where the repo is checked out on the VM. Defaults to ~/smart-agri-platform.
#VM_REPO_DIR=~/smart-agri-platform

# Compose project name, which prefixes every container. Defaults to smart-agri,
# giving container names like smart-agri-namenode-1.
#VM_CONTAINER_PREFIX=smart-agri
