# =============================================================================
# Hadoop configuration for the apache/hadoop image.
#
# The image converts `<FILE>.XML_<property>` variables into the matching Hadoop
# XML config files at container start, so this single file configures both the
# NameNode and the DataNode.
# =============================================================================

# ---- core-site.xml ----------------------------------------------------------
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.tmp.dir=/hadoop/tmp
CORE-SITE.XML_hadoop.http.staticuser.user=root
CORE-SITE.XML_hadoop.proxyuser.root.hosts=*
CORE-SITE.XML_hadoop.proxyuser.root.groups=*
CORE-SITE.XML_io.file.buffer.size=131072

# ---- hdfs-site.xml ----------------------------------------------------------
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data
HDFS-SITE.XML_dfs.datanode.http.address=0.0.0.0:9864
HDFS-SITE.XML_dfs.datanode.address=0.0.0.0:9866
HDFS-SITE.XML_dfs.datanode.ipc.address=0.0.0.0:9867

# Single-node lake: one replica, and no safemode stall on a tiny cluster.
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.namenode.safemode.threshold-pct=0

# Dev-only: the platform has no Kerberos, and HDFS ownership adds nothing here.
HDFS-SITE.XML_dfs.permissions.enabled=false

# WebHDFS is how the ETL app reads and writes the lake — it keeps the ETL image
# JVM-free (no libhdfs). It MUST stay enabled.
HDFS-SITE.XML_dfs.webhdfs.enabled=true

# Critical for WebHDFS across the Compose network: a write to the NameNode is
# redirected to a DataNode. Without these, the redirect carries a container IP
# that clients cannot route to; with them it carries the resolvable hostname.
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
