# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- Environment ----
.env
.env.local
*.local.env
# Verification VM connection details. This repo is public; .env.vm.example is
# the committed template.
.env.vm

# ---- Claude Code ----
# Machine-local permissions and overrides. .claude/settings.json is committed.
.claude/settings.local.json

# ---- Docker / runtime volumes ----
# Container state must never be committed. `make clean` recreates it.
.volumes/
docker/**/data/
logs/

# ---- Airflow ----
airflow/logs/
airflow/airflow.db
airflow/webserver_config.py

# ---- Liquibase ----
liquibase/*.log

# ---- Generated data ----
data/out/
*.parquet

# ---- Onboarding doc (local only) ----
# A generated reading aid, not part of the committed doc set. `docs/vendor/`
# holds its vendored Mermaid bundle so it renders with no network access.
docs/onboarding.html
docs/vendor/

# ---- Editors / OS ----
.idea/
.vscode/
.DS_Store
