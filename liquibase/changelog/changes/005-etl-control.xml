<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Pipeline state lives in Postgres rather than in Airflow Variables so it is
      transactional with nothing, queryable by anyone, and — importantly —
      testable without an Airflow instance.
    -->
    <changeSet id="005-1-watermark" author="data-platform">
        <createTable tableName="watermark" schemaName="etl_control"
                     remarks="High-water mark per incremental pipeline">
            <column name="pipeline" type="VARCHAR(100)">
                <constraints primaryKey="true" primaryKeyName="pk_watermark"/>
            </column>
            <column name="source_table" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="watermark_column" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <!-- Nullable: absent means "never run", which the extractor treats
                 as a full first load rather than an error. -->
            <column name="watermark_value" type="TIMESTAMPTZ"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="watermark" schemaName="etl_control"/>
        </rollback>
    </changeSet>

    <changeSet id="005-2-run-log" author="data-platform">
        <createTable tableName="run_log" schemaName="etl_control"
                     remarks="One row per pipeline execution">
            <column name="run_id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_run_log"/>
            </column>
            <column name="pipeline" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="logical_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="rows_read" type="BIGINT" defaultValueNumeric="0"/>
            <column name="rows_written" type="BIGINT" defaultValueNumeric="0"/>
            <column name="rows_quarantined" type="BIGINT" defaultValueNumeric="0"/>
            <column name="started_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMPTZ"/>
            <column name="error_message" type="TEXT"/>
        </createTable>

        <sql>
            ALTER TABLE etl_control.run_log ADD CONSTRAINT ck_run_log_status
                CHECK (status IN ('running', 'success', 'failed'));
            CREATE INDEX ix_run_log_pipeline_date
                ON etl_control.run_log (pipeline, logical_date DESC);
        </sql>

        <rollback>
            <dropTable tableName="run_log" schemaName="etl_control"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
