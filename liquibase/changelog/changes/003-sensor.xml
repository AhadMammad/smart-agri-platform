<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-1-sensor" author="data-platform">
        <createTable tableName="sensor" schemaName="agri" remarks="An in-field IoT soil probe">
            <column name="sensor_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_sensor"/>
            </column>
            <column name="sensor_code" type="VARCHAR(32)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_sensor_code"/>
            </column>
            <column name="field_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_sensor_field"
                             referencedTableSchemaName="agri"
                             referencedTableName="field"
                             referencedColumnNames="field_id"/>
            </column>
            <column name="sensor_type" type="VARCHAR(30)" remarks="soil_probe in Phase 2">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="depth_cm" type="SMALLINT" remarks="Installation depth of the probe">
                <constraints nullable="false"/>
            </column>
            <column name="installed_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <!-- Faulty and decommissioned sensors are what make the Silver
                 layer's filtering rules worth testing. -->
            <column name="status" type="VARCHAR(20)" defaultValue="active">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE agri.sensor ADD CONSTRAINT ck_sensor_status
                CHECK (status IN ('active', 'faulty', 'decommissioned'));
            ALTER TABLE agri.sensor ADD CONSTRAINT ck_sensor_depth
                CHECK (depth_cm BETWEEN 5 AND 200);
            CREATE INDEX ix_sensor_field_id ON agri.sensor (field_id);
            CREATE TRIGGER trg_sensor_touch BEFORE UPDATE ON agri.sensor
                FOR EACH ROW EXECUTE FUNCTION agri.touch_updated_at();
        </sql>

        <rollback>
            <dropTable tableName="sensor" schemaName="agri"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
